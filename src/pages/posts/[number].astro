---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";
import Comments from "../../components/Comments.astro";
import JsonLd from "../../components/JsonLd.astro";
import TagList from "../../components/TagList.astro";
import Toc from "../../components/Toc";
import Base from "../../layouts/Base.astro";
import { siteConfig } from "../../lib/config";
import { formatDate } from "../../lib/datetime";
import { withBase } from "../../lib/links";
import { absoluteUrl, blogPostingJsonLd, shareableImage } from "../../lib/seo";
import { getSite } from "../../lib/site";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  return posts.map((entry) => ({
    params: { number: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const sourceName = siteConfig.source === "issues" ? "Issue" : "Discussion";
const { profile } = await getSite();
const image = shareableImage(data.thumbnail);
---

<Base
  title={`${data.title} - ${siteConfig.websiteTitle}`}
  ogTitle={data.title}
  description={data.excerpt || undefined}
  image={image}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={data.createdAt} />
    <meta property="article:modified_time" content={data.updatedAt} />
    {data.tags.map((tag) => (
      <meta property="article:tag" content={tag.name} />
    ))}
    <JsonLd
      data={blogPostingJsonLd({
        title: data.title,
        url: absoluteUrl(Astro.url.pathname, Astro.site),
        description: data.excerpt,
        image,
        publishedAt: data.createdAt,
        modifiedAt: data.updatedAt,
        tags: data.tags.map((tag) => tag.name),
        author: { name: profile.name ?? profile.login, url: profile.url },
      })}
    />
  </Fragment>
  <nav aria-label="Breadcrumb" class="text-sm text-muted">
    <a href={withBase(import.meta.env.BASE_URL, "/")} class="hover:text-fg">
      Posts
    </a>
    <span aria-hidden="true" class="mx-2">
      /
    </span>
    <span>#{data.number}</span>
  </nav>
  <header class="mt-2 flex flex-wrap items-baseline gap-x-3 border-b border-rule pb-6 break-keep break-words">
    {/* Pagefind 1.5.2 also indexes this title metadata, so title-only searches still match even
    though the h1 sits outside data-pagefind-body; adding that attribute here would pull the title
    into excerpts below. The number stays outside the h1 so it doesn't become part of that title */}
    <h1
      class="min-w-0 text-3xl font-bold tracking-tight sm:text-4xl"
      data-pagefind-meta="title"
    >
      {data.title}
    </h1>
    <span class="text-3xl text-faint tabular-nums sm:text-4xl">
      #{data.number}
    </span>
  </header>
  <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_15.5rem] lg:gap-14">
    <aside
      class="text-sm lg:sticky lg:top-6 lg:order-last lg:self-start"
      data-pagefind-ignore
    >
      <dl class="grid grid-cols-[5rem_minmax(0,1fr)] gap-x-3 gap-y-2.5 border-b border-rule pb-5">
        {data.tags.length > 0 && (
          <>
            <dt class="text-muted">Labels</dt>
            <dd>
              <TagList tags={data.tags} />
            </dd>
          </>
        )}
        <dt class="text-muted">Posted</dt>
        <dd>
          <time datetime={data.createdAt} data-local-date="long">
            {formatDate(data.createdAt, "long")}
          </time>
        </dd>
        <dt class="text-muted">Comments</dt>
        <dd class="tabular-nums">{data.commentCount}</dd>
        <dt class="text-muted">Source</dt>
        <dd>
          <a
            href={data.url}
            class="underline underline-offset-3 hover:opacity-80"
          >
            {sourceName} #{data.number}
          </a>
        </dd>
      </dl>
      {/* below lg the contents would push the post itself off the first screen */}
      {data.toc.length > 0 && (
        <div class="mt-5 hidden lg:block">
          <p class="mb-2 text-muted">Contents</p>
          <Toc items={data.toc} client:idle />
        </div>
      )}
    </aside>
    <div class="min-w-0">
      {/* only post bodies go into the search index */}
      <article
        class="prose max-w-none break-keep break-words prose-code:before:content-none prose-code:after:content-none"
        data-pagefind-body
      >
        <Content />
      </article>
      <div class="mt-14 border-t border-rule pt-6" data-pagefind-ignore>
        <Comments number={data.number} />
      </div>
    </div>
  </div>
</Base>
