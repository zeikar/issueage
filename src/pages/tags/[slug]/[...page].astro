---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import Pagination from "../../../components/Pagination.astro";
import PostCard from "../../../components/PostCard.astro";
import Base from "../../../layouts/Base.astro";
import { siteConfig } from "../../../lib/config";
import { PAGE_SIZE } from "../../../lib/pagination";
import { byNewest } from "../../../lib/posts";
import { collectTags } from "../../../lib/tags";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("posts")).sort((a, b) =>
    byNewest(a.data, b.data),
  );
  // collectTags fails the build when two labels share a slug, so each slug names one tag page
  return collectTags(posts.map((entry) => entry.data)).flatMap((tag) =>
    paginate(
      posts.filter((entry) =>
        entry.data.tags.some(({ slug }) => slug === tag.slug),
      ),
      { pageSize: PAGE_SIZE, params: { slug: tag.slug }, props: { tag } },
    ),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, tag } = Astro.props;
const pageSuffix = page.currentPage > 1 ? ` - Page ${page.currentPage}` : "";
---

<Base title={`${tag.name} - ${siteConfig.websiteTitle}${pageSuffix}`}>
  <h1 class="mb-6 text-2xl font-bold break-keep break-words">
    Posts tagged “{tag.name}”
  </h1>
  <ul class="space-y-4">
    {page.data.map((entry) => (
      <li>
        <PostCard post={entry.data} />
      </li>
    ))}
  </ul>
  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prefix={`/tags/${tag.slug}`}
  />
</Base>
