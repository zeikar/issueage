---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import PostIndex from "../../../components/PostIndex.astro";
import Base from "../../../layouts/Base.astro";
import { siteConfig } from "../../../lib/config";
import { PAGE_SIZE } from "../../../lib/pagination";
import { byNewest } from "../../../lib/posts";
import { collectTags } from "../../../lib/tags";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("posts")).sort((a, b) =>
    byNewest(a.data, b.data),
  );
  // tagSlug derives each slug from its name alone, and collectTags throws if two names ever collide, so each slug names exactly one tag page
  return collectTags(posts.map((entry) => entry.data)).flatMap((tag) =>
    paginate(
      posts.filter((entry) =>
        entry.data.tags.some(({ slug }) => slug === tag.slug),
      ),
      { pageSize: PAGE_SIZE, params: { slug: tag.slug }, props: { tag } },
    ),
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, tag } = Astro.props;
const pageSuffix = page.currentPage > 1 ? ` - Page ${page.currentPage}` : "";
---

<Base title={`${tag.name} - ${siteConfig.websiteTitle}${pageSuffix}`}>
  <PostIndex
    heading={tag.name}
    total={page.total}
    posts={page.data}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prefix={`/tags/${tag.slug}`}
    currentSlug={tag.slug}
  />
</Base>
