---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import PostIndex from "../components/PostIndex.astro";
import Profile from "../components/Profile.astro";
import Base from "../layouts/Base.astro";
import { siteConfig } from "../lib/config";
import { PAGE_SIZE } from "../lib/pagination";
import { byNewest } from "../lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("posts")).sort((a, b) =>
    byNewest(a.data, b.data),
  );
  return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
const pageSuffix = page.currentPage > 1 ? ` - Page ${page.currentPage}` : "";
---

<Base title={`${siteConfig.websiteTitle}${pageSuffix}`}>
  <Profile />
  <div class="mt-10">
    <PostIndex
      heading="Posts"
      total={page.total}
      posts={page.data}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      prefix=""
    />
  </div>
</Base>
