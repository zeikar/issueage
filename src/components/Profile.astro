---
import { getEntry } from "astro:content";

const site = await getEntry("site", "site");
if (site === undefined) {
  throw new Error('the "site" collection has no "site" entry');
}
const { login, name, bio, avatarUrl, url, followers, following } =
  site.data.profile;
const displayName = name ?? login;
---

<section class="flex flex-wrap items-center gap-x-4 gap-y-2">
  <img
    src={avatarUrl}
    alt={`${displayName} avatar`}
    width="48"
    height="48"
    class="size-12 rounded-full"
  />
  <div class="min-w-0 break-keep break-words">
    <p class="font-semibold">{displayName}</p>
    {bio && <p class="text-sm text-muted">{bio}</p>}
  </div>
  <p class="flex gap-4 text-sm text-muted sm:ml-auto">
    <a href={`${url}?tab=followers`} class="hover:text-fg">
      <span class="font-semibold text-fg">{followers.totalCount}</span>{" "}
      followers
    </a>
    <a href={`${url}?tab=following`} class="hover:text-fg">
      <span class="font-semibold text-fg">{following.totalCount}</span>{" "}
      following
    </a>
  </p>
</section>
