---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/datetime";
import { postPath, withBase } from "../lib/links";
import TagList from "./TagList.astro";

interface Props {
  post: CollectionEntry<"posts">["data"];
}

const { post } = Astro.props;
---

<article class="rounded-lg border border-gray-200 p-5 dark:border-gray-800">
  <div class="flex gap-4">
    <div class="min-w-0 flex-1 break-keep break-words">
      <h2 class="text-xl font-semibold">
        <a
          href={withBase(import.meta.env.BASE_URL, postPath(post.number))}
          class="hover:underline"
        >
          {post.title}
        </a>
      </h2>
      {post.excerpt && (
        <p class="mt-2 text-gray-600 dark:text-gray-400">{post.excerpt}</p>
      )}
      <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
        <time datetime={post.createdAt} data-local-date>
          {formatDate(post.createdAt)}
        </time>{" "}
        <span aria-hidden="true">·</span>{" "}
        {`${post.commentCount} ${post.commentCount === 1 ? "comment" : "comments"}`}
      </p>
    </div>
    {post.thumbnail && (
      <img
        src={post.thumbnail}
        alt=""
        loading="lazy"
        class="size-24 shrink-0 rounded object-cover sm:size-32"
      />
    )}
  </div>
  <div class="mt-3">
    <TagList tags={post.tags} />
  </div>
</article>
