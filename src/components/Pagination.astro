---
import { pagePath, withBase } from "../lib/links";
import { getPaginationPages } from "../lib/pagination";

interface Props {
  currentPage: number;
  lastPage: number;
  prefix: string;
}

const { currentPage, lastPage, prefix } = Astro.props;
const href = (page: number) =>
  withBase(import.meta.env.BASE_URL, pagePath(prefix, page));
// posts are listed newest first, so the previous page holds newer posts
const newer = currentPage > 1 ? currentPage - 1 : null;
const older = currentPage < lastPage ? currentPage + 1 : null;
const stepClass = "hover:underline hover:underline-offset-3";
---

{lastPage > 1 && (
  <nav
    aria-label="Pagination"
    class="mt-6 flex items-center justify-between gap-4 text-sm"
  >
    {newer === null ? (
      <span class="text-faint">Newer</span>
    ) : (
      <a href={href(newer)} class={stepClass}>
        Newer
      </a>
    )}
    <span class="text-muted tabular-nums sm:hidden">
      Page {currentPage} of {lastPage}
    </span>
    <ul class="hidden items-center gap-0.5 sm:flex">
      {getPaginationPages(currentPage, lastPage).map((item) => (
        <li>
          {item === "…" ? (
            <span class="block px-2 text-muted">…</span>
          ) : (
            <a
              href={href(item)}
              aria-label={`Page ${item}`}
              aria-current={item === currentPage ? "page" : undefined}
              class:list={[
                "grid h-9 min-w-9 place-items-center rounded-md px-2 tabular-nums",
                item === currentPage
                  ? "bg-marker-fill font-semibold text-on-marker-fill selection:bg-fg selection:text-page"
                  : "text-muted hover:bg-surface hover:text-fg",
              ]}
            >
              {item}
            </a>
          )}
        </li>
      ))}
    </ul>
    {older === null ? (
      <span class="text-faint">Older</span>
    ) : (
      <a href={href(older)} class={stepClass}>
        Older
      </a>
    )}
  </nav>
)}
