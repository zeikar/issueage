---
import ThemeToggle from "./ThemeToggle";
import { siteConfig } from "../lib/config";
import { withBase } from "../lib/links";
---

<header class="border-b border-gray-200 dark:border-gray-800">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a
      href={withBase(import.meta.env.BASE_URL, "/")}
      class="text-xl font-bold hover:opacity-80"
    >
      {siteConfig.websiteTitle}
    </a>
    <div class="flex items-center gap-2">
      <form
        method="get"
        action={withBase(import.meta.env.BASE_URL, "/search/")}
        role="search"
      >
        <input
          name="q"
          type="search"
          placeholder="Search"
          aria-label="Search posts"
          class="w-32 rounded border border-gray-300 bg-transparent px-2 py-1 text-sm sm:w-48 dark:border-gray-700"
        />
      </form>
      <ThemeToggle client:load />
    </div>
  </nav>
</header>
