---
import { tagTextClass } from "../lib/color";
import { tagPath, withBase } from "../lib/links";

interface Props {
  tags: { name: string; color: string; slug: string }[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-1.5">
    {tags.map((tag) => (
      <li>
        <a
          href={withBase(import.meta.env.BASE_URL, tagPath(tag.slug))}
          class:list={[
            "relative z-10 inline-block rounded-full px-2.5 text-xs leading-5 font-semibold break-keep hover:opacity-80",
            tagTextClass(tag.color),
          ]}
          style={`background-color: #${tag.color}`}
        >
          {tag.name}
        </a>
      </li>
    ))}
  </ul>
)}
