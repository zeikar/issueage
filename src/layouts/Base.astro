---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { siteConfig } from "../lib/config";
import { DATE_FORMATS, DATE_LOCALE } from "../lib/datetime";
import { withBase } from "../lib/links";
import {
  absoluteUrl,
  ogImageFor,
  ogLocaleFor,
  siteDescription,
  siteUrl,
} from "../lib/seo";
import { getSite } from "../lib/site";

interface Props {
  title: string;
  // pages without their own summary are described by the site
  description?: string;
  image?: string;
  type?: "website" | "article";
  // for pages that shouldn't appear in search results, such as search results themselves
  noindex?: boolean;
}

const {
  title,
  description = siteDescription(await getSite()) ?? undefined,
  image,
  type = "website",
  noindex = false,
} = Astro.props;
const { googleAnalyticsId, websiteTitle, language } = siteConfig;
const pageUrl = absoluteUrl(Astro.url.pathname, Astro.site);
// a noindex page such as the 404 has no address worth sharing, so it gets no og:url and a card for the site instead
const cardUrl = noindex
  ? siteUrl(import.meta.env.BASE_URL, "/", Astro.site)
  : pageUrl;
const ogLocale = ogLocaleFor(language);
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={pageUrl} />
    )}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={websiteTitle} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {!noindex && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={image ?? ogImageFor(cardUrl)} />
    {ogLocale && <meta property="og:locale" content={ogLocale} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={websiteTitle}
      href={withBase(import.meta.env.BASE_URL, "/rss.xml")}
    />
    <slot name="head" />
    <link
      rel="icon"
      type="image/png"
      href={withBase(import.meta.env.BASE_URL, "/favicon.png")}
    />
    <script is:inline>
      // runs before the stylesheet loads, so the page never paints the wrong theme first;
      // localStorage can throw (e.g. Safari's "Block all cookies"), and a stored value could be anything, so guard both;
      // the block scopes these names, since inline scripts otherwise share one global scope and a later one could redeclare them
      {
        let stored;
        try {
          stored = localStorage.theme;
        } catch {}
        const theme =
          stored === "dark" || stored === "light"
            ? stored
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.classList.toggle("dark", theme === "dark");
      }
    </script>
    {googleAnalyticsId && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(googleAnalyticsId)}`}
        ></script>
        <script is:inline define:vars={{ googleAnalyticsId }}>
          {
            // Astro compiles define:vars scripts into an IIFE (dev and build), so a bare function
            // declaration here stays local; assign it to window explicitly so
            // gtag.js (and any future inline script) can still call window.gtag
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag("js", new Date());
            gtag("config", googleAnalyticsId);
          }
        </script>
      </>
    )}
  </head>
  <body class="flex min-h-screen flex-col bg-page text-fg">
    <Navbar />
    <main class="mx-auto w-full max-w-5xl flex-1 px-6 pt-8 pb-16">
      <slot />
    </main>
    <Footer />
    <script
      is:inline
      define:vars={{ dateLocale: DATE_LOCALE, dateFormats: DATE_FORMATS }}
    >
      // dates are built in UTC; re-render them in the reader's own time zone once the page is parsed,
      // keeping the format each element names in data-local-date (long when it names none)
      for (const time of document.querySelectorAll("time[data-local-date]")) {
        time.textContent = new Date(time.dateTime).toLocaleDateString(
          dateLocale,
          dateFormats[time.dataset.localDate] ?? dateFormats.long,
        );
      }
    </script>
  </body>
</html>
